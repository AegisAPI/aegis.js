{
  "name": "aegis-api",
  "version": "0.1.1",
  "description": "Typed client for the Aegis API.",
  "keywords": [
    "aegis",
    "discord",
    "bot",
    "discord.js",
    "typescript",
    "api-client"
  ],
  "license": "MIT",
  "author": "Mubi",
  "homepage": "https://github.com/AegisAPI/aegis.js#readme",
  "bugs": "https://github.com/AegisAPI/aegis.js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AegisAPI/aegis.js.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "schema:build": "openapi-typescript https://api.aegi.run/openapi.json -o src/generated/schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.md\" \"*.json\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.md\" \"*.json\" \"*.mjs\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
